# Local development values only. Use secrets from a secret manager in production.
POSTGRES_DB=pethop
POSTGRES_USER=pethop
POSTGRES_PASSWORD=dev-only-change-this-password
DB_URL=jdbc:postgresql://localhost:5432/pethop
DB_USERNAME=pethop
DB_PASSWORD=dev-only-change-this-password
SERVER_PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
FILE_STORAGE_PATH=./var/pethop-files
VITE_API_URL=http://localhost:8080/api/v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTRATION_MAX_REQUESTS=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_REPORT_MAX_REQUESTS=10
RATE_LIMIT_REPORT_WINDOW_SECONDS=3600
RATE_LIMIT_VETERINARY_MAX_REQUESTS=20
RATE_LIMIT_VETERINARY_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# Password recovery is temporarily disabled.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_MAIL_FROM=no-reply@pethop.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_MAIL_ENABLED=false
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_MAIL_FROM=no-reply@pethop.local
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
PETHOP_DATA_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Veterinary assistant. Disabled by default; never expose the key to Vite/frontend.
VETERINARY_AI_ENABLED=false
VETERINARY_AI_API_KEY=
VETERINARY_AI_BASE_URL=https://api.openai.com/v1/chat/completions
VETERINARY_AI_MODEL=gpt-4o-mini
VETERINARY_AI_CONNECT_TIMEOUT_MS=5000
VETERINARY_AI_READ_TIMEOUT_SECONDS=30
VETERINARY_AI_MAX_OUTPUT_TOKENS=700
